# Copied to deploy/oracle/.env by bootstrap.sh (git-ignored, mode 0600). Never commit the real file.
# Public host name Caddy serves and gets a certificate for. No domain? <public-ip-with-dashes>.sslip.io works, e.g. 129-80-1-2.sslip.io
SITE_ADDRESS=
# Caddyfile.api (web on Vercel) or Caddyfile.full (everything here)
CADDYFILE=Caddyfile.api
# The browser origin that talks to the API: the Vercel URL (api mode) or https://$SITE_ADDRESS (full mode). No trailing slash.
WEB_ORIGIN=
NEXT_PUBLIC_SITE_URL=
CONSOLE_COOKIE_SECURE=true
# Everyone reaches the API from Caddy's (or Vercel's) address, so the per-IP public limit is shared by all visitors.
RATE_LIMIT_PER_MINUTE=600
# Cold OPA is not a problem on this box (it stays warm), but a busy VM may need more than 200 ms.
OPA_TIMEOUT_SECONDS=1
# 1 only for the very first boot (demo data, console users, the hero review); bootstrap.sh sets it back to 0.
SEED_ON_BOOT=0
# Generated by bootstrap.sh (also listed in keys/console-logins.txt, mode 0600). Do not print them.
CONSOLE_PASSWORD_REV_ALICE=
CONSOLE_PASSWORD_REV_BOB=
CONSOLE_PASSWORD_SUB_USER123=
CONSOLE_PASSWORD_ADMIN_OPS=
