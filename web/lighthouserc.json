{
  "ci": {
    "collect": {
      "url": ["http://localhost:5173/", "http://localhost:5173/evaluation"],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --use-gl=angle --use-angle=swiftshader --ignore-gpu-blocklist" }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median" }],
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
