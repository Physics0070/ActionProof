      "get": {
        "description": "PyMuPDF render of page n of a document in the server's store, with a rectangle around every DIRECT\nclaim of this request that cites (doc, n) and passed verification. The doc id is only a key of the store's\nmanifest (never a path).",
        "operationId": "page_png_api_requests__request_hash__page__n__png_get",
        "parameters": [
          {
            "in": "path",
