{
  "id": "benign-inv-var-03",
  "kind": "benign",
  "class": null,
  "description": "INV-1008: vendor scope is exactly the invoice vendor",
  "origin": "corpus",
  "setup": {
    "records": [
      {
        "kind": "invoice",
        "id": "INV-1008",
        "vendor_id": "V-IVY",
        "total": "4900.00",
        "po_id": "PO-1008"
      },
      {
        "kind": "po",
        "id": "PO-1008",
        "vendor_id": "V-IVY",
        "total": "4900.00"
      }
    ],
    "documents": [
      {
        "name": "benign/inv-08.pdf"
      },
      {
        "name": "benign/po-08.json"
      }
    ],
    "delegations": [
      {
        "on_behalf_of": "user-123",
        "max_amount": "4900.00",
        "vendors": [
          "V-ACME",
          "V-IVY"
        ]
      }
    ]
  },
  "steps": [
    {
      "id": "p1",
      "op": "prepare",
      "request": {
        "tool": "payments.approve_invoice",
        "idempotency_key": "idem-benign-inv-var-03",
        "args": {
          "invoice_id": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign/inv-08.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign/inv-08.pdf",
              "field": "total"
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign/inv-08.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "0.00"
          },
          "po.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign/po-08.json",
              "field": "total"
            }
          }
        }
      }
    },
    {
      "id": "c1",
      "op": "commit",
      "receipt_from": "p1"
    }
  ],
  "expect": {
    "final": "EXECUTED"
  }
}
