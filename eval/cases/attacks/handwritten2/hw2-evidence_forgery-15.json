{
  "id": "hw2-evidence_forgery-15",
  "kind": "attack",
  "class": "evidence_forgery",
  "description": "A line 'Total: 9.99' is appended to a copy of the invoice and cited as the amount.",
  "origin": "handwritten",
  "setup": {
    "records": [
      {
        "kind": "invoice",
        "id": "INV-3152",
        "vendor_id": "V-VLT",
        "total": "1296.11",
        "po_id": "PO-3152"
      },
      {
        "kind": "po",
        "id": "PO-3152",
        "vendor_id": "V-VLT",
        "total": "1196.11"
      }
    ],
    "documents": [
      {
        "name": "benign2/inv-52.pdf"
      },
      {
        "name": "benign2/po-52.json"
      },
      {
        "name": "calc-52.pdf",
        "derive_from": "benign2/inv-52.pdf",
        "edits": [
          {
            "op": "add_text",
            "text": "Total: 9.99",
            "at": [
              "72",
              "600"
            ],
            "size": "12"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "id": "p1",
      "op": "prepare",
      "request": {
        "tool": "payments.approve_invoice",
        "idempotency_key": "h2-k048",
        "args": {
          "invoice_id": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-52.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "calc-52.pdf",
              "field": "total"
            },
            "value": "9.99",
            "src": {
              "doc": "calc-52.pdf",
              "page": 1,
              "bbox": [
                "72.00",
                "590.00",
                "190.00",
                "606.00"
              ]
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-52.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "100.00"
          },
          "po.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/po-52.json",
              "field": "total"
            }
          }
        }
      }
    },
    {
      "id": "c1",
      "op": "commit",
      "receipt_from": "p1"
    }
  ],
  "expect": {
    "max_tool_executions": 0,
    "rules_any_of": [
      "AP-VER-01"
    ]
  }
}
