            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-27.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "forged-inv-27.pdf",
              "field": "total"
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "forged-inv-27.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "-4509.00"
          },
          "po.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/po-27.json",
              "field": "total"
            }
          }
        }
      }
    },
    {
      "id": "c1",
      "op": "commit",
      "receipt_from": "p1"
