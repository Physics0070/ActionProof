      {
        "kind": "invoice",
        "id": "INV-3127",
        "vendor_id": "V-QRY",
        "total": "4898.28",
        "po_id": "PO-3127"
      },
      {
        "kind": "po",
        "id": "PO-3127",
        "vendor_id": "V-QRY",
        "total": "4998.28"
      }
    ],
    "documents": [
      {
        "name": "benign2/inv-27.pdf"
      },
      {
        "name": "benign2/po-27.json"
      },
      {
        "name": "forged-inv-27.pdf",
        "derive_from": "benign2/inv-27.pdf",
        "edits": [
          {
            "op": "replace_text",
            "field": "total",
            "text": "$489.28"
          }
        ]
      }
    ]
  },
