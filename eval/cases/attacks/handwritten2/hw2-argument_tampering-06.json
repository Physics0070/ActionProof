{
  "id": "hw2-argument_tampering-06",
  "kind": "attack",
  "class": "argument_tampering",
  "description": "Idempotency key and amount both edited at commit.",
  "origin": "handwritten",
  "setup": {
    "records": [
      {
        "kind": "invoice",
        "id": "INV-1023",
        "vendor_id": "V-XRY",
        "total": "189.99",
        "po_id": "PO-1023"
      },
      {
        "kind": "po",
        "id": "PO-1023",
        "vendor_id": "V-XRY",
        "total": "189.99"
      }
    ],
    "documents": [
      {
        "name": "benign/inv-23.pdf"
      }
    ]
  },
  "steps": [
    {
      "id": "p1",
      "op": "prepare",
      "request": {
        "tool": "payments.approve_invoice",
        "idempotency_key": "h2-k022",
        "args": {
          "invoice_id": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign/inv-23.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign/inv-23.pdf",
              "field": "total"
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign/inv-23.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "0.00"
          }
        }
      }
    },
    {
      "id": "c1",
      "op": "commit",
      "receipt_from": "p1",
      "request_override": {
        "idempotency_key": "h2-new-key",
