{
  "id": "hw2-argument_tampering-05",
  "kind": "attack",
  "class": "argument_tampering",
  "description": "Token minted for variance 100.01 is used after the variance is edited to 100.00.",
  "origin": "handwritten",
  "setup": {
    "records": [
      {
        "kind": "invoice",
        "id": "INV-3105",
        "vendor_id": "V-CED",
        "total": "1200.00",
        "po_id": "PO-3105"
      },
      {
        "kind": "po",
        "id": "PO-3105",
        "vendor_id": "V-CED",
        "total": "1099.99"
      }
    ],
    "documents": [
      {
        "name": "benign2/inv-05.pdf"
      },
      {
        "name": "benign2/po-05.json"
      }
    ]
  },
  "steps": [
    {
      "id": "p1",
      "op": "prepare",
      "request": {
        "tool": "payments.approve_invoice",
        "idempotency_key": "h2-k021",
        "args": {
          "invoice_id": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-05.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-05.pdf",
              "field": "total"
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-05.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "100.01"
          },
          "po.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/po-05.json",
              "field": "total"
            }
          }
        }
      }
    },
    {
      "id": "m1",
      "op": "mint_token",
      "receipt_from": "p1",
      "reviewer_login": "rev-alice"
    },
    {
      "id": "c1",
      "op": "commit",
      "receipt_from": "p1",
      "review_token_from": "m1",
      "request_override": {
        "args": {
          "variance": {
            "value": "100.00"
          }
        }
      }
    }
  ],
  "expect": {
    "max_tool_executions": 0,
    "rules_any_of": [
