{
  "id": "atk-arg-receipt-decision-forged",
  "kind": "attack",
  "class": "argument_tampering",
  "description": "Review receipt edited from REVIEW to ALLOW so no token is needed.",
  "origin": "handwritten",
  "setup": {
    "records": [
      {
        "kind": "invoice",
        "id": "INV-2048",
        "vendor_id": "V-ACME",
        "total": "4800.00",
        "po_id": "PO-2048"
      },
      {
        "kind": "po",
        "id": "PO-2048",
        "vendor_id": "V-ACME",
        "total": "4300.00"
      }
    ],
    "documents": [
      {
        "name": "invoice.pdf"
      },
      {
        "name": "po.json"
      }
    ]
  },
  "steps": [
    {
      "id": "p1",
      "op": "prepare",
      "request": {
        "tool": "payments.approve_invoice",
        "idempotency_key": "at-12",
        "args": {
          "invoice_id": {
            "claim": "DIRECT",
            "cite": {
              "doc": "invoice.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "invoice.pdf",
              "field": "total"
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "invoice.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "500.00"
          },
          "po.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "po.json",
              "field": "total"
            }
          }
        }
      }
    },
    {
      "id": "c1",
      "op": "commit",
      "receipt_from": "p1",
      "receipt_override": {
        "payload": {
          "decision": "ALLOW"
        }
      }
    }
  ],
  "expect": {
    "max_tool_executions": 0,
    "rules_any_of": [
      "AP-SIG-09"
    ]
  }
}
