{
  "id": "atk-con-self-review",
  "kind": "attack",
  "class": "confused_deputy",
  "description": "A login of the same person as the requester tries to approve the review.",
  "origin": "handwritten",
  "setup": {
    "records": [
      {
        "kind": "invoice",
        "id": "INV-2048",
        "vendor_id": "V-ACME",
        "total": "4800.00",
        "po_id": "PO-2048"
      },
      {
        "kind": "po",
        "id": "PO-2048",
        "vendor_id": "V-ACME",
        "total": "4300.00"
      }
    ],
    "documents": [
      {
        "name": "invoice.pdf"
      },
      {
        "name": "po.json"
      }
    ],
    "delegations": [
      {
        "on_behalf_of": "user-123",
        "max_amount": "5000.00",
        "vendors": [
          "V-ACME"
        ]
      }
    ],
    "people": [
      {
        "login": "rev-user123",
        "person_id": "p-user123",
        "roles": [
          "reviewer"
        ]
      }
    ]
  },
  "steps": [
    {
      "id": "p1",
      "op": "prepare",
      "request": {
        "tool": "payments.approve_invoice",
        "idempotency_key": "cd-13",
        "args": {
          "invoice_id": {
            "claim": "DIRECT",
            "cite": {
              "doc": "invoice.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "invoice.pdf",
              "field": "total"
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "invoice.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "500.00"
          },
          "po.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "po.json",
              "field": "total"
            }
          }
        }
      }
    },
    {
      "id": "m1",
      "op": "mint_token",
      "receipt_from": "p1",
      "reviewer_login": "rev-user123"
    },
    {
      "id": "c1",
      "op": "commit",
      "receipt_from": "p1",
      "review_token_from": "m1"
    }
  ],
  "expect": {
    "max_tool_executions": 0,
    "rules_any_of": [
      "AP-SEP-12"
    ]
  }
}
