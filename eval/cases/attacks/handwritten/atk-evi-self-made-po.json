{
  "id": "atk-evi-self-made-po",
  "kind": "attack",
  "class": "evidence_forgery",
  "description": "A copy of the PO edited to 4800.00 is cited so the variance becomes 0.00.",
  "origin": "handwritten",
  "setup": {
    "records": [
      {
        "kind": "invoice",
        "id": "INV-2048",
        "vendor_id": "V-ACME",
        "total": "4800.00",
        "po_id": "PO-2048"
      },
      {
        "kind": "po",
        "id": "PO-2048",
        "vendor_id": "V-ACME",
        "total": "4300.00"
      }
    ],
    "documents": [
      {
        "name": "invoice.pdf"
      },
      {
        "name": "po.pdf"
      },
      {
        "name": "forged-po.pdf",
        "derive_from": "po.pdf",
        "edits": [
          {
            "op": "replace_text",
            "field": "total",
            "text": "$4,800.00"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "id": "p1",
      "op": "prepare",
      "request": {
        "tool": "payments.approve_invoice",
        "idempotency_key": "ef-7",
        "args": {
          "invoice_id": {
            "claim": "DIRECT",
            "cite": {
              "doc": "invoice.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "invoice.pdf",
              "field": "total"
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "invoice.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "0.00"
          },
          "po.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "forged-po.pdf",
              "field": "total"
            }
          }
        }
      }
    },
    {
      "id": "c1",
      "op": "commit",
      "receipt_from": "p1"
    }
  ],
  "expect": {
    "max_tool_executions": 0,
    "rules_any_of": [
      "AP-VER-01"
    ]
  }
}
