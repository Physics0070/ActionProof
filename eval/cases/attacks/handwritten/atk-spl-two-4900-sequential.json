{
  "id": "atk-spl-two-4900-sequential",
  "kind": "attack",
  "class": "split_payments",
  "description": "Two 4900.00 approvals to one vendor, committed one after the other.",
  "origin": "handwritten",
  "setup": {
    "records": [
      {
        "kind": "invoice",
        "id": "INV-3102",
        "vendor_id": "V-BRK",
        "total": "4900.00",
        "po_id": "PO-3102"
      },
      {
        "kind": "po",
        "id": "PO-3102",
        "vendor_id": "V-BRK",
        "total": "4900.00"
      },
      {
        "kind": "invoice",
        "id": "INV-3103",
        "vendor_id": "V-BRK",
        "total": "4900.00",
        "po_id": "PO-3103"
      },
      {
        "kind": "po",
        "id": "PO-3103",
        "vendor_id": "V-BRK",
        "total": "4800.00"
      }
    ],
    "documents": [
      {
        "name": "benign2/inv-02.pdf"
      },
      {
        "name": "benign2/po-02.json"
      },
      {
        "name": "benign2/inv-03.pdf"
      },
      {
        "name": "benign2/po-03.json"
      }
    ]
  },
  "steps": [
    {
      "id": "p1",
      "op": "prepare",
      "request": {
        "tool": "payments.approve_invoice",
        "idempotency_key": "sp-1a",
        "args": {
          "invoice_id": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-02.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-02.pdf",
              "field": "total"
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-02.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "0.00"
          },
          "po.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/po-02.json",
              "field": "total"
            }
          }
        }
      }
    },
    {
      "id": "p2",
      "op": "prepare",
      "request": {
        "tool": "payments.approve_invoice",
        "idempotency_key": "sp-1b",
        "args": {
          "invoice_id": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-03.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-03.pdf",
              "field": "total"
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-03.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "100.00"
          },
          "po.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/po-03.json",
              "field": "total"
            }
          }
        }
      }
    },
    {
      "id": "c1",
      "op": "commit",
      "receipt_from": "p1"
    },
    {
      "id": "c2",
      "op": "commit",
      "receipt_from": "p2"
    }
  ],
  "expect": {
    "max_tool_executions": 1,
    "rules_any_of": [
      "AP-CUM-03"
    ]
  }
}
