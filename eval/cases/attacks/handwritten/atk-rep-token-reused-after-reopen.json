{
  "id": "atk-rep-token-reused-after-reopen",
  "kind": "attack",
  "class": "replay",
  "description": "An approved invoice is reopened; the old token is offered for a fresh approval.",
  "origin": "handwritten",
  "setup": {
    "records": [
      {
        "kind": "invoice",
        "id": "INV-3105",
        "vendor_id": "V-CED",
        "total": "1200.00",
        "po_id": "PO-3105"
      },
      {
        "kind": "po",
        "id": "PO-3105",
        "vendor_id": "V-CED",
        "total": "1099.99"
      }
    ],
    "documents": [
      {
        "name": "benign2/inv-05.pdf"
      },
      {
        "name": "benign2/po-05.json"
      }
    ]
  },
  "steps": [
    {
      "id": "p1",
      "op": "prepare",
      "request": {
        "tool": "payments.approve_invoice",
        "idempotency_key": "rp-8a",
        "args": {
          "invoice_id": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-05.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-05.pdf",
              "field": "total"
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-05.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "100.01"
          },
          "po.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/po-05.json",
              "field": "total"
            }
          }
        }
      }
    },
    {
      "id": "m1",
      "op": "mint_token",
      "receipt_from": "p1",
      "reviewer_login": "rev-alice"
    },
    {
      "id": "c1",
      "op": "commit",
      "receipt_from": "p1",
      "review_token_from": "m1"
    },
    {
      "id": "reopen",
      "op": "mutate_record",
      "record_id": "invoice:INV-3105",
      "set": {
        "status": "open"
      }
    },
    {
      "id": "p2",
      "op": "prepare",
      "request": {
        "tool": "payments.approve_invoice",
        "idempotency_key": "rp-8b",
        "args": {
          "invoice_id": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-05.pdf",
              "field": "invoice_id"
            }
          },
          "amount": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-05.pdf",
              "field": "total"
            }
          },
          "invoice.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/inv-05.pdf",
              "field": "total"
            }
          },
          "variance": {
            "claim": "DERIVED",
            "fn": "sub",
            "inputs": [
              "invoice.total",
              "po.total"
            ],
            "value": "100.01"
          },
          "po.total": {
            "claim": "DIRECT",
            "cite": {
              "doc": "benign2/po-05.json",
              "field": "total"
            }
          }
        }
      }
    },
    {
      "id": "c2",
      "op": "commit",
      "receipt_from": "p2",
      "review_token_from": "m1"
    }
  ],
  "expect": {
    "max_tool_executions": 1,
    "rules_any_of": [
      "AP-REV-10",
      "AP-REP-05"
    ]
  }
}
