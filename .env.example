# Postgres (compose + gateway). Dev defaults only; no secrets belong in this file.
PG_USER=actionproof
PG_PASSWORD=actionproof-dev
PG_DB=actionproof
PG_PORT=5433
# DSN the gateway and tests use.
DATABASE_URL=postgresql://actionproof:actionproof-dev@localhost:5433/actionproof
# OPA sidecar base URL (ADR-005).
OPA_URL=http://localhost:8181
OPA_PORT=8181
# Path to the Tesseract binary used by the vision pass (ADR-002).
TESSERACT_CMD=C:/Users/Soham/Tesseract-OCR/tesseract.exe
# Warm tesseract processes kept ready (0 = off, max 16; ADR-018). Starting tesseract costs ~150 ms; a warm one answers in ~10 ms. Use >= the number of distinct PDF boxes per request (about 3).
OCR_POOL_SIZE=4
# Ed25519 signing seed file (32 bytes), read only by the gate process (ADR-007). Create with scripts/gen_key.py; git-ignored.
SIGNING_KEY_PATH=keys/dev-signing.key
# Key id stamped on every receipt (rotate by changing key + kid together).
SIGNING_KID=k1
# Receipt lifetime in seconds after prepare (AP-EXP-06).
RECEIPT_TTL_SECONDS=300
# Human review token lifetime in seconds (AP-REV-10).
REVIEW_TOKEN_TTL_SECONDS=3600
# Gateway -> OPA call timeout in seconds; timeout = DENY AP-POL-FAIL (ADR-005).
OPA_TIMEOUT_SECONDS=0.2
# Sign an audit checkpoint every N audit entries (positive int). Keep 1: entries after the last checkpoint can be
# truncated undetected, so N>1 trades signatures for an unpinned tail of up to N-1 entries.
AUDIT_CHECKPOINT_EVERY=1
# Verifier CLI only (python -m actionproof.audit verify): file holding the gate's base64 Ed25519 PUBLIC key
# (Signer.public_key_b64()). Never point this at the signing seed; the verifier needs no secret.
AUDIT_PUBLIC_KEY_PATH=keys/dev-signing.pub
# After a key rotation: a directory of <kid>.pub files (one per key ever used); takes precedence over AUDIT_PUBLIC_KEY_PATH.
# AUDIT_PUBLIC_KEYS_DIR=keys/pub
# Postgres binaries for scripts/dev_pg.py (local dev without Docker).
PG_BIN=C:/Users/Soham/tools/pgsql/bin
# OPA binary for local policy tests / server without Docker.
OPA_BIN=C:/Users/Soham/tools/opa/opa.exe
# MCP server (python -m actionproof.server). stdio: the Principal the OPERATOR assigns this client (ADR-012); the
# request body must match it. HTTP uses bearer tokens (api_clients, scripts/seed_api_client.py) instead.
ACTIONPROOF_ACTOR=agent-7
ACTIONPROOF_ON_BEHALF_OF=user-123
# The server's document store: a directory holding manifest.json (doc ids are manifest keys, never paths).
DOCS_DIR=fixtures/out
# Per-principal tool calls per minute (in-memory token bucket).
RATE_LIMIT_PER_MINUTE=60
# HTTP transport port (127.0.0.1 only).
SERVER_PORT=8765
# Lifetime of REVIEW receipts only (a human review can take longer than RECEIPT_TTL_SECONDS); AP-EXP-06 still applies.
REVIEW_RECEIPT_TTL_SECONDS=3600
# Proxy mode (python -m actionproof.server --proxy "<upstream cmd>"): the upstream tool map (examples/proxy-map.json).
PROXY_MAP_PATH=examples/proxy-map.json
# Review console (python -m actionproof.console): the only CORS origin allowed (the web UI), with credentials.
WEB_ORIGIN=http://localhost:5173
# Console session lifetime in seconds (server-side; the cookie holds a random id, the DB only its sha256).
SESSION_TTL_SECONDS=28800
# Secure flag on console cookies: auto (only on https requests) | true | false.
CONSOLE_COOKIE_SECURE=auto
# Console API port (127.0.0.1 only).
CONSOLE_PORT=8766
# Dev console passwords for scripts/seed_console.py (optional; unset = generated and printed once). Never commit real ones.
# CONSOLE_PASSWORD_REV_ALICE=
# LLM-judge baseline arm (slide 5 output-filter row): Groq's OpenAI-compatible API via httpx. Put the real key in a git-ignored .env or your shell, never in this file.
GROQ_API_KEY=
# Judge model id on Groq, e.g. llama-3.3-70b-versatile (must be set to run the judge arm).
JUDGE_MODEL=
# --- Web (web/, Next.js). Next reads these from web/.env.local or the shell; both are required at build and dev. ---
# Same-origin path prefix the browser calls; next.config.ts rewrites it to CONSOLE_API_ORIGIN/api so cookies stay first-party.
NEXT_PUBLIC_API_BASE=/api
# Console backend origin (server-side only: rewrite target and server-rendered fetches). Port = CONSOLE_PORT.
CONSOLE_API_ORIGIN=http://127.0.0.1:8766
# --- Ship (docker-compose.yml, Dockerfile.api, web/Dockerfile; see docs/RUNBOOK.md) ---
# Host path of the Ed25519 seed mounted as the compose secret `signing_key` (never baked into an image).
SIGNING_KEY_FILE=./keys/signing.key
# Host path of the hex Postgres password mounted as compose secret `pg_password` (python -c "import secrets;print(secrets.token_hex(24))").
PG_PASSWORD_SECRET_FILE=./keys/pg_password
# 1 = init wipes ALL tables (incl. the audit chain) and seeds demo data + console users; leave 0 for anything real.
DEMO_SEED=0
# Console login passwords used by init when DEMO_SEED=1 (unset = generated, printed once in `docker compose logs init`).
# CONSOLE_PASSWORD_REV_BOB= / CONSOLE_PASSWORD_SUB_USER123= / CONSOLE_PASSWORD_ADMIN_OPS= work the same way as REV_ALICE.
# Interface the published api port binds on the host (127.0.0.1 = this machine only).
API_BIND=127.0.0.1
# Host port for the published api (container side is always 8766).
API_PORT=8766
# Interface the published web port binds on the host.
WEB_BIND=127.0.0.1
# Host port for the published web (container side is always 5173).
WEB_PORT=5173
# Linux hosts: uid/gid the api container runs as; set to the owner of keys/signing.key so the secret file is readable.
APP_UID=10001
APP_GID=10001
# OPA image for the sidecar (must be a -debug tag: the healthcheck uses busybox wget).
OPA_IMAGE=openpolicyagent/opa:1.22.2-debug
# Console bind host (default 127.0.0.1; docker-compose sets 0.0.0.0 inside the container, published on loopback).
CONSOLE_BIND_HOST=127.0.0.1

