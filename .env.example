# Postgres (compose + gateway). Dev defaults only; no secrets belong in this file.
PG_USER=actionproof
PG_PASSWORD=actionproof-dev
PG_DB=actionproof
PG_PORT=5433
# DSN the gateway and tests use.
DATABASE_URL=postgresql://actionproof:actionproof-dev@localhost:5433/actionproof
# OPA sidecar base URL (ADR-005).
OPA_URL=http://localhost:8181
OPA_PORT=8181
# Path to the Tesseract binary used by the vision pass (ADR-002).
TESSERACT_CMD=C:/Users/Soham/Tesseract-OCR/tesseract.exe
# Ed25519 signing seed file (32 bytes), read only by the gate process (ADR-007). Create with scripts/gen_key.py; git-ignored.
SIGNING_KEY_PATH=keys/dev-signing.key
# Key id stamped on every receipt (rotate by changing key + kid together).
SIGNING_KID=k1
# Receipt lifetime in seconds after prepare (AP-EXP-06).
RECEIPT_TTL_SECONDS=300
# Human review token lifetime in seconds (AP-REV-10).
REVIEW_TOKEN_TTL_SECONDS=3600
# Gateway -> OPA call timeout in seconds; timeout = DENY AP-POL-FAIL (ADR-005).
OPA_TIMEOUT_SECONDS=0.2
# Postgres binaries for scripts/dev_pg.py (local dev without Docker).
PG_BIN=C:/Users/Soham/tools/pgsql/bin
# OPA binary for local policy tests / server without Docker.
OPA_BIN=C:/Users/Soham/tools/opa/opa.exe
